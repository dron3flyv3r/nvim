    "description": "Load a training checkpoint"
  },

  "PyTorch save best model": {
    "prefix": "pytorch:save:best",
    "body": [
      "best_loss = float(\"inf\")",
      "",
      "if ${1:validation_loss} < best_loss:",
      "    best_loss = ${1:validation_loss}",
      "    torch.save(model.state_dict(), \"${2:best_model.pt}\")"
    ],
    "description": "Save the model when validation loss improves"
  },

  "PyTorch tensor shape debug": {
